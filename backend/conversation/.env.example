# Copy to .env and fill in. Never commit .env.

# Supabase (service role key: backend only, never ship to a frontend)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=

# LiteLLM proxy that the agent talks to
LLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-gtw-local
DIALOGUE_MODEL=gtw
EXTRACTION_MODEL=gtw
EXTRACTION_JSON_MODE=true

# Gonka brokers used by litellm/config.yaml (OpenAI-compatible base URLs, usually ending in /v1)
BROKER_A_API_BASE=
BROKER_A_API_KEY=
BROKER_B_API_BASE=
BROKER_B_API_KEY=

# Check-in behaviour
NO_ANSWER_TIMEOUT_S=30
