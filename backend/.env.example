# Runtime and migration connections for Supabase Postgres.
DATABASE_URL=
DIRECT_URL=

# Protects both the Garmin ingest and read endpoints.
ADMIN_API_TOKEN=

# Unofficial Garmin Connect sync (one consenting Garmin account).
# The password and MFA code are entered interactively and are never put here.
GARMIN_EMAIL=
GARMIN_SUBJECT_ID=person-1
GARMIN_TOKEN_STORE=.garmin-tokens
GARMIN_SYNC_DAYS=2
GARMIN_SYNC_INTERVAL_MINUTES=15
BACKEND_URL=http://127.0.0.1:3000
# Optional: set this after scanning if more than one HR device is nearby.
GARMIN_BLE_ADDRESS=

HOST=0.0.0.0
PORT=3000
